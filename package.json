{
  "name": "thaiserkit-supply-next",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/workers/index.ts",
    "worker:dev": "tsx watch src/workers/index.ts",
    "build:cloudflare": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "preview:cloudflare": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cloudflare": "opennextjs-cloudflare build && wrangler deploy",
    "audit:release": "node scripts/release-audit.mjs",
    "audit:source": "node scripts/source-audit.mjs",
    "migration:audit": "node scripts/migration-audit.mjs",
    "legacy:audit": "node scripts/legacy-import-audit.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.65",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.1",
    "@mui/material": "^9.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.10.0",
    "@tanstack/react-query": "^5.87.1",
    "ai": "^7.0.97",
    "bullmq": "^5.58.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.44.0",
    "meilisearch": "^0.62.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^10.0.3",
    "openai": "^7.13.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.270.0",
    "posthog-node": "^5.9.0",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.2",
    "react": "19.3.x",
    "react-dom": "19.3.x",
    "react-hook-form": "^7.62.0",
    "resend": "^6.0.2",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@opennextjs/cloudflare": "^1.11.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "3.2.4",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.1.0",
    "msw": "^2.11.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
