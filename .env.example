# =============================================================
# THAISERKIT SUPPLY — Next.js GodTier environment
# Copy to .env.local for local development. Never commit secrets.
# =============================================================
NODE_ENV=development
APP_VERSION=5.2.0
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Public business identity / SEO structured data
BUSINESS_LEGAL_NAME=บริษัท ไทยเซอร์กิจ ซัพพลาย จำกัด
BUSINESS_TRADING_NAME=THAISERKIT SUPPLY
BUSINESS_TAGLINE=เครื่องมือช่างและอุปกรณ์การเกษตร
BUSINESS_DESCRIPTION=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_TAX_ID=
BUSINESS_STREET=89 หมู่ 9 บ้านห้วยบง ต.น้ำแวน
BUSINESS_LOCALITY=อ.เชียงคำ
BUSINESS_REGION=จ.พะเยา
BUSINESS_POSTAL_CODE=56110
BUSINESS_PHONE=088-2608042
BUSINESS_EMAIL=thaiserkit.supply@gmail.com
BUSINESS_OPENING_HOURS=จันทร์ – เสาร์ 07.00 – 17.00 น.
BUSINESS_OPENING_HOURS_SPEC=
BUSINESS_LATITUDE=
BUSINESS_LONGITUDE=

# Platform owner / authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SECRET=
# Optional separate HMAC secret for signed Equipment Set / Bundle discount quotes.
# If empty, AUTH_SECRET is used.
KIT_QUOTE_SECRET=
AUTH_PLATFORM_EMAIL=
AUTH_PLATFORM_PASSWORD=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Commerce document store (settings/content/session and API data source)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=product-media

# Primary relational database / Drizzle
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thaiserkit

# Commerce compatibility storage. Defaults to direct PostgreSQL when DATABASE_URL exists.
# Set to "supabase" only when intentionally using Supabase PostgREST as the transport.
COMMERCE_STORAGE=postgres
POSTGRES_POOL_MAX=5
# Keep the native relational catalogue synchronized with commerce product writes.
CATALOG_TABLE_DUAL_WRITE=1
# Relational order projection/read path. Keep enabled during the Next-native cutover.
RELATIONAL_ORDER_MIRROR=1
RELATIONAL_ORDER_READS=1
RELATIONAL_REPORT_READS=1

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=8

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey
MEILISEARCH_PRODUCT_INDEX=products

# AI — OpenAI SDK + AI SDK
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_INSIGHT_PROVIDER=openai
AI_INSIGHT_MODEL=
GEMINI_API_KEY=
N8N_AI_WEBHOOK_URL=
N8N_AI_API_KEY=

# S3-compatible storage / Cloudflare R2
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_FORCE_PATH_STYLE=true
# Generic aliases used by Next storage helpers
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1

# Payments
PROMPTPAY_ID=
OMISE_SECRET_KEY=
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# Email — existing SMTP + Resend
ORDER_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=THAISERKIT SUPPLY <orders@example.com>

# Telegram
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_CHAT_BOT_TOKEN=
TELEGRAM_CHAT_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=

# Storefront contact / Facebook Customer Chat (public)
NEXT_PUBLIC_FB_PAGE_ID=
NEXT_PUBLIC_FB_THEME_COLOR=#0B2E22
NEXT_PUBLIC_FB_PAGE_USERNAME=
NEXT_PUBLIC_LINE_OA_URL=
NEXT_PUBLIC_LINE_OA_ID=@thaiserkit
NEXT_PUBLIC_LINE_QR_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_PHONE=088-2608042

# Marketplace / Social
FACEBOOK_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Multi tenant
TOGROW_TENANTS=[{"id":"tsk","name":"THAISERKIT SUPPLY","hosts":["localhost"]}]
# QA/local only: permit ?tenant=... to override Host scoping on /api/v1. Never enable in production.
TOGROW_ALLOW_TENANT_QUERY=0

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost

# Analytics / monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
OTEL_EXPORTER_OTLP_ENDPOINT=

# Cron / workers
CRON_SECRET=
